SHORT_DOMAIN=tpcode.uk
PUBLIC_BASE_URL=https://staff.tpcode.uk
SHOP_NAME=Tuttoprint
SHOP_CONTACT="info@tuttoprint.co.uk · Edmonton Green, London"
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
RETENTION_DAYS=30
PENDING_RETENTION_HOURS=24
BG_REPLACE=false
# Background checkbox remains opt-in; HR is the default tool when selected.
BACKGROUND_ENGINE=hr
BACKGROUND_PYTHON=/absolute/path/to/.background-venv/bin/python
BACKGROUND_TIMEOUT_SECONDS=300
# Optional: BACKGROUND_MODEL_DIR=/absolute/path/to/models/background
# Local enhancer uses the same optional runtime by default. Models are opt-in.
# ENHANCER_PYTHON=/absolute/path/to/.background-venv/bin/python
# ENHANCER_MODEL_DIR=/absolute/path/to/models/enhancement
# ENHANCER_TIMEOUT_SECONDS=300
AUTO_ADJUST=false
FIX_SHADOWS=false
EVEN_BG=false
PUBLIC_UPLOADS=false
DATA_DIR=./data
# OpenAI lighting / colour preparation. Set the secret only on the server.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TIMEOUT_SECONDS=180
# Optional HTTPS page for the Irish provider you choose. No Irish code API is used.
IRISH_PROVIDER_URL=
# Optional: email codes to customers
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
